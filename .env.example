# SUPABASE
VITE_SUPABASE_URL=           # Supabase → Project Settings → API → Project URL
VITE_SUPABASE_ANON_KEY=      # Supabase → Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Project Settings → API → service_role (nunca expor no frontend)

# CLAUDE API
CLAUDE_API_KEY=               # console.anthropic.com → API Keys

# RESEND
RESEND_API_KEY=               # resend.com → API Keys
RESEND_FROM_EMAIL=            # ex: briefing@radarIA.com.br

# EVOLUTION API (WHATSAPP)
EVOLUTION_URL=                # URL da instância Evolution
EVOLUTION_KEY=                # Evolution → API Key global
EVOLUTION_INSTANCE=           # nome da instância criada

# STRIPE
STRIPE_SECRET_KEY=            # stripe.com → Developers → API Keys → Secret key
STRIPE_WEBHOOK_SECRET=        # stripe.com → Developers → Webhooks → Signing secret
VITE_STRIPE_PUBLISHABLE_KEY=  # stripe.com → Developers → API Keys → Publishable key

# APIFY
APIFY_WEBHOOK_SECRET=         # string aleatória que você define para validar origem
APIFY_API_TOKEN=              # apify.com → Settings → Integrations → API token
